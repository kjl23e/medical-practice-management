<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment2.ViewAppointmentsPage"
             Title="View Appointments">
    <Grid RowDefinitions="Auto,*" Padding="20">
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <Label Text="Appointments List" FontSize="20" FontAttributes="Bold"/>
            <Button x:Name="BackButton" Text="Back to Home"/>
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="AppointmentsContainer" Spacing="15"/>
        </ScrollView>
    </Grid>
</ContentPage>